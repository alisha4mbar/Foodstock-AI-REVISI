# Salin menjadi .env di SERVER lalu isi semuanya.
# Domain tanpa https://. Tanpa domain sendiri: pakai IP-server.sslip.io  (mis. 203-0-113-10.sslip.io)
DOMAIN=203-0-113-10.sslip.io
FOODSTOCK_ADMIN_EMAILS=admin@foodstock.com
# Opsional: password (min 8) untuk akun dinas@, bulog@, distributor@foodstock.com. Kosong = tidak dibuat.
FOODSTOCK_ROLE_PASSWORD=
SESSION_SECRET=ganti-string-acak-panjang
# Buat: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=
DB_DATABASE=foodstock_ai
DB_USERNAME=foodstock
DB_PASSWORD=ganti-password-db-kuat
DB_ROOT_PASSWORD=ganti-password-root-kuat
