# Salin menjadi .env lalu isi.
# Email yang otomatis menjadi Admin Utama saat login pertama (pisahkan koma bila lebih dari satu)
FOODSTOCK_ADMIN_EMAILS=admin@foodstock.com
# Opsional: password (min 8) untuk akun dinas@, bulog@, distributor@foodstock.com. Kosong = tidak dibuat.
FOODSTOCK_ROLE_PASSWORD=
# Kunci acak untuk cookie sesi frontend (ganti!)
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Opsional: biarkan kosong untuk dibuat otomatis. Isi agar tetap sama:  php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=
DB_DATABASE=foodstock_ai
DB_USERNAME=foodstock
DB_PASSWORD=foodstock_pass
DB_ROOT_PASSWORD=root_pass
